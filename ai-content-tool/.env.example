# ---- 腳本生成 (擇一或都填) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 語音合成 (可選,ElevenLabs 音質較自然;不填則用免費的 gTTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 語速倍率,1.0=原速,建議 1.2~1.4 之間(數值越大語速越快,音調不會跑掉)
# 用 gTTS 時是事後加速處理;用 ElevenLabs 時走原生語速控制,聲音更自然
TTS_SPEED=1.3

# ---- YouTube 上傳 (需先在 Google Cloud Console 建立 OAuth 用戶端) ----
# 下載 client_secret.json 後,把路徑填在這裡
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# 影片預設隱私狀態: public / unlisted / private (建議先用 unlisted / private 測試)
YOUTUBE_DEFAULT_PRIVACY=private

# ---- 選題研究 (可選,不填則只能用 --topic 手動指定主題) ----
TRENDS_REGION=TW

# ---- 影片長度 ----
# shorts = 60-90秒短影音(預設,適合YouTube Shorts/Reels/TikTok)
# long   = 2-4分鐘深度版(場景數更多、內容更完整)
SCRIPT_LENGTH=shorts

# ---- 腳本風格 ----
# explainer = 科普/開箱/比較類(預設)
# story     = 第一人稱敘事、生活趣事類短片(強制去識別化,不得寫成真實病人/個案)
SCRIPT_STYLE=explainer

# ---- 背景素材 (可選,免費申請 https://www.pexels.com/api/ ;不填則用純色漸層背景) ----
PEXELS_API_KEY=
