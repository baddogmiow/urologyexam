# ---- 腳本生成 (擇一或都填) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 語音合成 (可選,ElevenLabs 音質較自然;不填則用免費的 gTTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- YouTube 上傳 (需先在 Google Cloud Console 建立 OAuth 用戶端) ----
# 下載 client_secret.json 後,把路徑填在這裡
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# 影片預設隱私狀態: public / unlisted / private (建議先用 unlisted / private 測試)
YOUTUBE_DEFAULT_PRIVACY=private

# ---- 選題研究 (可選,不填則只能用 --topic 手動指定主題) ----
TRENDS_REGION=TW

# ---- 背景素材 (可選,免費申請 https://www.pexels.com/api/ ;不填則用純色漸層背景) ----
PEXELS_API_KEY=
